# smaGukji 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 git 에 커밋되지 않습니다)
#
# 값은 Java properties 형식으로 파싱됩니다:
#   - 값 안에 '#' 이 있으면 주석으로 잘리므로 '\#' 로 이스케이프하세요.
#   - 값 안에 '\' 가 있으면 '\\' 로 이스케이프하세요.
#   - 따옴표로 감싸지 마세요. 따옴표까지 값에 포함됩니다.

# ---------------------------------------------------------------
# Supabase Postgres (Dashboard > Project Settings > Database > Connection string)
# ---------------------------------------------------------------
# Session pooler (IPv4 지원, Flyway/JPA 에 권장) - 포트 5432
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# Direct connection (IPv6 전용) 을 쓰려면 위 3줄 대신 아래를 사용하세요.
# SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# Transaction pooler(포트 6543)는 prepared statement 를 지원하지 않으므로
# 반드시 아래 파라미터를 URL 에 추가해야 합니다:
#   ?sslmode=require&prepareThreshold=0&preparedStatementCacheQueries=0

# ---------------------------------------------------------------
# 백엔드
# ---------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
SIMULATION_MAX_ITERATIONS=200000
SIMULATION_DEFAULT_ITERATIONS=20000

# ---------------------------------------------------------------
# 전보 인식 (NVIDIA 비전 모델, /api/ocr/battle-report)
# ---------------------------------------------------------------
# 전보(전투 결과) 스크린샷에서 텍스트를 읽어내는 데 쓴다. 없어도 배포는 되지만
# «전보 검증» 화면에서 인식 버튼을 누르면 오류가 난다.
# https://build.nvidia.com 에서 API 키를 발급받으세요. 사용량에 따라 비용이 들 수 있습니다.
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 기본값은 NVIDIA 카탈로그의 비전 모델이다. 다른 모델을 쓰려면 바꾸세요.
# NVIDIA_OCR_MODEL=meta/llama-3.2-90b-vision-instruct

# ---------------------------------------------------------------
# 시뮬레이션 프로젝트 연동 (읽기 전용 API: /api/integration/v1/**)
# ---------------------------------------------------------------
# 밖에 따로 떠 있는 시뮬레이션 프로젝트가 장수·전법·버프를 읽어갈 때 쓰는 열쇠입니다.
# 사람이 아니라 서버가 부르는 창구라 로그인 화면을 거칠 수 없어, 미리 나눠 가진 열쇠
# 하나(X-API-Key 헤더)로 엽니다. 같은 값을 시뮬레이션 프로젝트에도 넣으세요.
#
#   생성:  openssl rand -base64 32     (24자 이상. 짧으면 기동 로그에 경고가 남습니다)
#
# 비워두면 그 구간이 통째로 닫힙니다. 설정을 빠뜨린 채 데이터가 열려 있는 것보다 낫습니다.
# INTEGRATION_API_KEY=

# 시뮬레이션 «화면» 이 브라우저에서 직접 부를 때만 그 주소를 넣습니다.
# 서버끼리 부르면 CORS 자체가 필요 없으므로 보통 비워둡니다.
# (브라우저에서 부르면 열쇠가 사용자에게 그대로 노출된다는 점을 알고 쓰세요)
# INTEGRATION_ALLOWED_ORIGINS=https://your-simulation.example.com

# ---------------------------------------------------------------
# 카드 이미지 원본 (장수/ 전법/ 하위 폴더를 가진 디렉터리)
# 경로 구분자는 '/' 를 쓰세요. properties 파싱에서 '\' 는 이스케이프 문자입니다.
# ---------------------------------------------------------------
ASSET_SOURCE_DIR=C:/Users/chanha/OneDrive/Desktop/천하결전
# true 로 두면 기동할 때마다 자동 적재(변경분만). 평소엔 false 로 두고
# POST http://localhost:8080/api/assets/import 로 수동 실행하는 편이 낫습니다.
ASSET_IMPORT_ON_STARTUP=false

# ---------------------------------------------------------------
# 프론트엔드 (frontend/.env 로 복사, VITE_ 접두사만 브라우저에 노출됨)
# ---------------------------------------------------------------
# VITE_API_BASE_URL=/api
# 프론트에서 Supabase Auth 를 직접 쓸 경우에만 필요 (anon key 는 공개되어도 안전한 키입니다)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------
# Render 배포 (선택) — ./render-deploy.sh 를 쓸 때만 필요
# https://render.com 가입 → Account Settings → API Keys → Create API Key
# ---------------------------------------------------------------
# RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxx
