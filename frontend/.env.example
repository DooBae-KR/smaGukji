# 프론트엔드 환경변수
#
# 로컬에서 쓰려면 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 git 에 올라가지 않는다).
# 배포에서는 Netlify → Site configuration → Environment variables 에 같은 이름으로 넣는다.
#
# ⚠️ VITE_ 로 시작하는 값은 빌드 결과물에 그대로 들어간다. 즉 «공개된다».
#    비밀로 지켜야 하는 값(DB 비밀번호, service_role 키)은 절대 여기 두지 않는다.

# Supabase 프로젝트 주소.  Project Settings → API → Project URL
VITE_SUPABASE_URL=https://yzjbaenqfnyqfoaxqegu.supabase.co

# anon(공개) 키.  Project Settings → API → Project API keys → anon public
#
# 공개되는 것이 정상이다. 이 키만으로는 아무 데이터도 읽히지 않는다.
# 실제 차단은 DB 의 RLS 정책이 한다(V18/V19).
# service_role 키는 모든 정책을 무시하므로 여기에 넣으면 안 된다.
VITE_SUPABASE_ANON_KEY=

# «버튼 눌러서 하는 일»(시트 동기화·CSV import·인사 xlsx 업로드·자산 카운트) 은
# Netlify Functions 로 옮겨서 같은 오리진의 /api 를 그대로 쓴다(Render 는 더 이상 없음).
# 비워두면 같은 오리진의 /api 로 간다(로컬 개발에서는 vite 프록시가 받는다).
VITE_API_BASE_URL=

# 로그인 아이디를 이메일로 바꿀 때 붙이는 도메인.
#
# 사용자는 «cjswhrnr» 같은 아이디를 쓰지만 Supabase Auth 는 이메일 기반이라 붙여야 한다.
# 실제로 메일을 보내지 않으므로 절대 실재하지 않는 예약 도메인(RFC 2606)을 쓴다.
# 한 번 정하면 바꾸지 않는다. 바꾸면 기존 계정으로 로그인할 수 없다.
VITE_LOGIN_EMAIL_DOMAIN=smagukji.invalid
