# 프론트엔드 + nginx.
#
# 정적 파일을 nginx 이미지 안에 굽는다. 볼륨으로 넘기지 않는 이유는, 볼륨을 쓰면
# «지금 떠 있는 nginx 가 어느 빌드의 파일을 들고 있는지» 를 알 수 없게 되기 때문이다.
# 이미지에 넣으면 태그 하나로 프론트 버전이 정해진다.
#
# nginx 설정은 굽지 않고 바깥에서 마운트한다. 도메인마다 달라지는 값이라
# 이미지에 넣으면 도메인을 바꿀 때마다 다시 빌드해야 한다.

# ---------------------------------------------------------------
# 1) 빌드
# ---------------------------------------------------------------
# alpine(musl) 대신 slim(glibc). Vite 8 의 rolldown 이 플랫폼별 네이티브 바이너리를 쓰는데
# Windows 에서 만든 package-lock.json 에 musl 바이너리가 없어 alpine 에서 npm ci 가 깨진다.
FROM node:24-slim AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./

# Vite 는 VITE_* 를 «빌드 시점에» 번들에 새긴다. 런타임 환경변수로는 바뀌지 않는다.
#
# VITE_API_BASE_URL 은 비워 둔다. 프론트와 API 가 같은 도메인이라 /api 로 가면 되고,
# nginx 가 그걸 백엔드로 넘긴다. 값을 넣으면 브라우저가 다른 오리진으로 보내 CORS 를 탄다.
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_ANON_KEY=""
ARG VITE_API_BASE_URL=""
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---------------------------------------------------------------
# 2) nginx
# ---------------------------------------------------------------
FROM nginx:1.27-alpine

# 기본 설정을 치운다. 남겨두면 우리 설정과 함께 읽혀 80 포트를 두 번 잡는다.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html
