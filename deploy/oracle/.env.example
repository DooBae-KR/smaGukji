# Oracle Cloud 배포용 환경변수.
#
#   cp .env.example .env   그리고 값을 채운다
#
# ⚠️ 이 파일은 서버에만 둔다. git 에 올리지 않는다(.gitignore 의 .env.*).

# ---------------------------------------------------------------
# SSL
# ---------------------------------------------------------------
# 인증서를 받을 도메인. Let's Encrypt 는 IP 주소로는 발급해 주지 않으므로
# 이름이 반드시 하나 있어야 한다. 도메인이 없으면 Dynu 에서 무료로 받는다.
DOMAIN=smagukji.freeddns.org

# 동적 DNS 갱신 주소. 공급자가 알려주는 «업데이트 URL» 을 그대로 붙여 넣는다.
# 5분마다 이 주소를 부른다. 비워 두면 아무 일도 하지 않는다(예약 IP 를 쓰는 경우).
#
# 왜 필요한가: 오라클 인스턴스를 중지했다 켜면 공인 IP 가 바뀔 수 있다. 그때 도메인이
# 엉뚱한 곳을 가리키지 않도록 지금 IP 를 알려 준다.
#
#   DuckDNS  https://www.duckdns.org/update?domains=<이름>&token=<토큰>&ip=
#   Dynu     https://api.dynu.com/nic/update?hostname=<전체도메인>&password=<IP갱신 비밀번호>
#   No-IP    https://<아이디>:<비밀번호>@dynupdate.no-ip.com/nic/update?hostname=<전체도메인>
#
# ⚠️ 비밀번호가 들어간 주소다. 이 파일을 git 에 올리지 않는다.
DDNS_UPDATE_URL=

# 만료 안내를 받을 주소. 실제로 받을 수 있는 주소를 넣는다.
CERT_EMAIL=you@example.com

# 설정을 시험하는 동안에는 1 로 두어 연습용 인증서를 받는다. 진짜 서버는 같은 도메인에
# 주당 5회까지만 발급해 주므로, 시행착오를 진짜 서버에서 하면 금방 막힌다.
# 잘 되는 것을 확인한 뒤 이 줄을 지우고 certbot/ 폴더를 비우고 다시 발급받는다.
#STAGING=1

# ---------------------------------------------------------------
# 프론트엔드 (빌드 시점에 번들에 새겨진다)
# ---------------------------------------------------------------
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://yzjbaenqfnyqfoaxqegu.supabase.co

# anon(공개) 키. 브라우저에 나가는 것이 정상이다. 실제 차단은 DB 의 RLS 가 한다.
# service_role 키는 절대 넣지 않는다.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# 백엔드
# ---------------------------------------------------------------
# 로그인 토큰을 검증할 Supabase 주소. 비어 있으면 /api 가 전부 401 이 된다.
SUPABASE_URL=https://yzjbaenqfnyqfoaxqegu.supabase.co

SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# 프론트와 API 가 같은 오리진(도메인 하나)이라 CORS 가 필요 없다.
# 프론트를 따로 배포하는 경우에만 그 주소를 넣는다. 와일드카드는 쓰지 않는다.
CORS_ALLOWED_ORIGINS=

# Always Free 인스턴스는 메모리가 넉넉해 Render(512MB) 때보다 풀을 키울 수 있다.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

JPA_DDL_AUTO=none
ASSET_IMPORT_ON_STARTUP=false
APP_MIN_PASSWORD_LENGTH=8

# «데이터» 탭의 시트 불러오기가 쓰는 값. 공개 시트 URL 이라 비밀값은 아니다.
GENERAL_SHEET_CSV_URL=
ROSTER_SHEET_CSV_URL=
TACTIC_SHEET_CSV_URL=
BUFF_SHEET_CSV_URL=
# 열전 탭. 백엔드 동기화가 생기면 쓴다. (값은 루트 .env 참고)
BOND_SHEET_CSV_URL=
